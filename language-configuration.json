{
    "comments": {
        // MISA only has line comments; "##" lines are doc comments.
        "lineComment": "#"
    },
    // symbols used as brackets (only parentheses exist in MISA expressions)
    "brackets": [
        ["(", ")"]
    ],
    // symbols that are auto closed when typing
    "autoClosingPairs": [
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] }
    ],
    // symbols that can be used to surround a selection
    "surroundingPairs": [
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    // identifiers, qualified names (STRUCT.field) and numbers
    "wordPattern": "(-?\\d[\\w.]*)|([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
    "onEnterRules": [
        {
            // keep writing a doc comment block: "## text" + Enter → "## "
            "beforeText": "^\\s*##",
            "action": { "indent": "none", "appendText": "## " }
        }
    ]
}
