{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Mnemonimov Assembly",
	"scopeName": "source.mnemonimov",
	"fileTypes": [
		".asm",
		".misa",
		".mnemo"
	],
	"patterns": [
		{
			"include": "#doc-comment"
		},
		{
			"include": "#comment"
		},
		{
			"include": "#include-directive"
		},
		{
			"include": "#emb-file-directive"
		},
		{
			"include": "#directive"
		},
		{
			"include": "#string"
		},
		{
			"include": "#char"
		},
		{
			"include": "#instruction"
		},
		{
			"include": "#cast"
		},
		{
			"include": "#type"
		},
		{
			"include": "#condition"
		},
		{
			"include": "#syscall"
		},
		{
			"include": "#builtin-symbol"
		},
		{
			"include": "#register"
		},
		{
			"include": "#number"
		},
		{
			"include": "#reusable-label"
		},
		{
			"include": "#entry-point-def"
		},
		{
			"include": "#local-label-def"
		},
		{
			"include": "#global-label-def"
		},
		{
			"include": "#operator"
		}
	],
	"repository": {
		"doc-comment": {
			"comment": "Documentation comments (##), e.g. the lines after an sbmk signature header",
			"name": "comment.block.documentation.mnemonimov",
			"match": "##.*$"
		},
		"comment": {
			"comment": "Single-line comments starting with # (but not ##)",
			"name": "comment.line.number-sign.mnemonimov",
			"match": "(?<!#)#(?!#).*$"
		},
		"include-directive": {
			"comment": "include \"path\" — the path is verbatim; @u/ and @s/ are virtual folders",
			"match": "(?:(?<=^)|(?<=:))\\s*\\b(include)\\b\\s*(\")(@[us](?=[/\\\\]))?([^\"]*)(\")",
			"captures": {
				"1": {
					"name": "keyword.control.directive.include.mnemonimov"
				},
				"2": {
					"name": "string.quoted.double.path.mnemonimov punctuation.definition.string.begin.mnemonimov"
				},
				"3": {
					"name": "constant.language.virtual-folder.mnemonimov"
				},
				"4": {
					"name": "string.quoted.double.path.mnemonimov"
				},
				"5": {
					"name": "string.quoted.double.path.mnemonimov punctuation.definition.string.end.mnemonimov"
				}
			}
		},
		"emb-file-directive": {
			"comment": "emb file \"path\" — embeds a .png or .bin file",
			"match": "(?:(?<=^)|(?<=:))\\s*\\b(emb)\\s+(file)\\b\\s*,?\\s*(\")(@[us](?=[/\\\\]))?([^\"]*)(\")",
			"captures": {
				"1": {
					"name": "keyword.control.directive.mnemonimov"
				},
				"2": {
					"name": "entity.name.type.mnemonimov"
				},
				"3": {
					"name": "string.quoted.double.path.mnemonimov punctuation.definition.string.begin.mnemonimov"
				},
				"4": {
					"name": "constant.language.virtual-folder.mnemonimov"
				},
				"5": {
					"name": "string.quoted.double.path.mnemonimov"
				},
				"6": {
					"name": "string.quoted.double.path.mnemonimov punctuation.definition.string.end.mnemonimov"
				}
			}
		},
		"directive": {
			"comment": "Assembler directives, only at the start of a statement",
			"patterns": [
				{
					"comment": "emb: the non-scalar types string and file are only valid here",
					"begin": "(?:(?<=^)|(?<=:))\\s*\\b(emb)\\b\\s*(?:\\b(string|file)\\b)?",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.directive.mnemonimov"
						},
						"2": {
							"name": "entity.name.type.mnemonimov"
						}
					},
					"end": "(?=#|$)",
					"patterns": [
						{
							"include": "$self"
						}
					]
				},
				{
					"match": "(?:(?<=^)|(?<=:))\\s*\\b(def|undef|res|bmk|sbmk|include)\\b",
					"captures": {
						"1": {
							"name": "keyword.control.directive.mnemonimov"
						}
					}
				}
			]
		},
		"string": {
			"comment": "Double-quoted string literals (single line)",
			"name": "string.quoted.double.mnemonimov",
			"begin": "\"",
			"end": "\"|$",
			"patterns": [
				{
					"name": "constant.character.escape.mnemonimov",
					"match": "\\\\[0tn'\\\"\\\\]"
				},
				{
					"name": "invalid.illegal.unknown-escape.mnemonimov",
					"match": "\\\\."
				}
			]
		},
		"char": {
			"comment": "Character literals: 1 to 4 ASCII characters packed into an integer ('ab' == 0x6162)",
			"name": "string.quoted.single.char.mnemonimov",
			"begin": "'",
			"end": "'|$",
			"patterns": [
				{
					"name": "constant.character.escape.mnemonimov",
					"match": "\\\\[0tn'\\\"\\\\]"
				},
				{
					"name": "invalid.illegal.unknown-escape.mnemonimov",
					"match": "\\\\."
				}
			]
		},
		"instruction": {
			"comment": "MISA instructions, only at the start of a statement",
			"match": "(?:(?<=^)|(?<=:))\\s*\\b(syscall|fatan2|frsqrt|break|facos|fasin|fatan|fsqrt|vfadd|vfdiv|vffma|vfmul|vfsub|yield|cala|clpu|divu|dnrm|exit|fabs|fadd|fcei|fclp|fcos|fctf|fcti|fdiv|fdtr|fexp|fflo|ffma|ffra|flog|flrp|fmax|fmin|fmod|fmul|fneg|fpow|frem|frnd|frou|frtd|fsgn|fsin|fsub|ftan|ftru|fwrp|gbpx|gtpx|jfsa|jmpa|jtra|maxu|minu|mlhu|norm|remu|sbpx|stpx|vmov|vpop|vpsh|abs|add|and|bfi|cal|cea|clp|clz|cmp|ctz|dec|div|fma|inc|jfs|jmp|jtr|lde|lod|max|min|mlh|mod|mov|mul|mvc|neg|nop|not|orr|pbd|pbx|pop|pow|ppc|psh|rem|ret|rnd|rol|ror|rvb|sar|sbx|sel|sgn|sll|slr|ste|str|sub|swp|tpa|tpr|ubx|xor)\\b",
			"captures": {
				"1": {
					"name": "support.function.instruction.mnemonimov"
				}
			}
		},
		"cast": {
			"comment": "Unary cast operators used in expressions",
			"name": "keyword.operator.word.cast.mnemonimov",
			"match": "\\b(icast|fcast)\\b"
		},
		"type": {
			"comment": "Scalar types used with emb, res, lod, str, lde, ste",
			"name": "entity.name.type.mnemonimov",
			"match": "\\b(f32t|i16t|i32t|u16t|u32t|i8t|u8t)\\b"
		},
		"condition": {
			"comment": "Comparison conditions used with the cmp instruction",
			"name": "constant.language.condition.mnemonimov",
			"match": "\\b(fneqa|feqa|finf|fnan|gteu|lteu|fgt|flt|gte|gtu|lte|ltu|neq|eq|gt|lt)\\b"
		},
		"syscall": {
			"comment": "System call names used with the syscall instruction",
			"name": "constant.language.syscall.mnemonimov",
			"match": "\\b(SYS_GET_TERMINAL_INPUT_SIZE|SYS_GET_MOUSE_BUTTON_INPUT|SYS_PRESERVE_FRONT_BUFFER|SYS_PRESERVE_BACK_BUFFER|SYS_DRAW_TEXTURE_REGION|SYS_READ_TERMINAL_INPUT|SYS_GET_KEYBOARD_INPUT|SYS_GET_MOUSE_POSITION|SYS_ALLOW_UNSAFE_JUMP|SYS_PRINT_LINE_STRING|SYS_GET_RUNNING_TIME|SYS_GET_UPDATE_DELTA|SYS_PRINT_LINE_FLOAT|SYS_GET_DRAW_DELTA|SYS_PRINT_LINE_INT|SYS_GET_UNIX_TIME|SYS_STORAGE_WRITE|SYS_DRAW_TEXTURE|SYS_PRINT_STRING|SYS_SET_RNG_SEED|SYS_STORAGE_READ|SYS_PRINT_FLOAT|SYS_DRAW_RECT|SYS_GET_INPUT|SYS_PRINT_INT|SYS_MEM_COPY|SYS_MEM_SET)\\b"
		},
		"builtin-symbol": {
			"comment": "Built-in constants and the assembler address $",
			"patterns": [
				{
					"name": "constant.language.builtin.mnemonimov",
					"match": "\\b(MAX_TERMINAL_INPUT_SIZE|MOUSE_BTN_WHEEL_DOWN|MOUSE_BTN_WHEEL_UP|MOUSE_BTN_MIDDLE|MOUSE_BTN_RIGHT|MOUSE_BTN_LEFT|KEY_BACKSPACE|KEY_PAGE_DOWN|SCREEN_HEIGHT|SCREEN_WIDTH|KBE_PRESSED|KEY_PAGE_UP|BTN_SELECT|KBE_REPEAT|KEY_DELETE|KEY_INSERT|BTN_RIGHT|BTN_START|KBE_SHIFT|KEY_ENTER|KEY_RIGHT|KEY_SHIFT|BTN_DOWN|BTN_LEFT|KBE_CTRL|KEY_CTRL|KEY_DOWN|KEY_HOME|KEY_LEFT|KBE_ALT|KEY_ALT|KEY_END|KEY_ESC|KEY_TAB|BTN_UP|KEY_UP|BTN_A|BTN_B|BTN_X|BTN_Y|false|EXP1|true|INF|NAN|TAU|PI)\\b"
				},
				{
					"name": "constant.language.builtin.mnemonimov",
					"match": "\\$"
				}
			]
		},
		"register": {
			"comment": "General-purpose registers (t0-t15, a0-a15, s0-s31) and special-purpose registers",
			"patterns": [
				{
					"name": "variable.language.register.mnemonimov",
					"match": "\\bt(1[0-5]|[0-9])\\b"
				},
				{
					"name": "variable.language.register.mnemonimov",
					"match": "\\ba(1[0-5]|[0-9])\\b"
				},
				{
					"name": "variable.language.register.mnemonimov",
					"match": "\\bs(3[01]|[12][0-9]|[0-9])\\b"
				},
				{
					"name": "variable.language.register.special.mnemonimov",
					"match": "\\b(zr|cr|ea|pa|ba|sp|fp|pc)\\b"
				}
			]
		},
		"number": {
			"comment": "Numeric literals with optional underscore separators; no scientific notation",
			"patterns": [
				{
					"name": "constant.numeric.hex.mnemonimov",
					"match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*\\b"
				},
				{
					"name": "constant.numeric.binary.mnemonimov",
					"match": "\\b0b[01][01_]*\\b"
				},
				{
					"name": "constant.numeric.octal.mnemonimov",
					"match": "\\b0o[0-7][0-7_]*\\b"
				},
				{
					"name": "constant.numeric.float.mnemonimov",
					"match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
				},
				{
					"name": "constant.numeric.integer.mnemonimov",
					"match": "\\b[0-9][0-9_]*\\b"
				}
			]
		},
		"reusable-label": {
			"comment": "Reusable labels: @name: definitions and @name- / @name+ references",
			"name": "entity.name.label.reusable.mnemonimov",
			"match": "@[A-Za-z_][A-Za-z0-9_]*[+-]?"
		},
		"entry-point-def": {
			"comment": "Built-in process entry points scheduled by the kernel",
			"name": "entity.name.function.entry-point.mnemonimov",
			"match": "^\\s*(?:_mouse_button_input|_keyboard_input|_terminal_input|_update|_input|_start|_draw)(?=\\s*:)"
		},
		"local-label-def": {
			"comment": "Local label definitions: .name:",
			"name": "entity.name.label.local.mnemonimov",
			"match": "^\\s*\\.[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)"
		},
		"global-label-def": {
			"comment": "Global label definitions: name: (at the start of a line, optionally indented)",
			"name": "entity.name.label.mnemonimov",
			"match": "^\\s*[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)"
		},
		"operator": {
			"comment": "Expression operators and the vector range operator",
			"name": "keyword.operator.mnemonimov",
			"match": "\\.\\.|\\*\\*|%%|<<|>>|&&|\\|\\||==|!=|<=|>=|[+\\-*/%~&|^!<>]"
		}
	}
}
